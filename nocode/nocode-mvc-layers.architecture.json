  "cards": [
    {
      "dot": "cyan",
      "title": "Two front doors",
      "items": [
        "REST API: one endpoint per controller under app/<area>",
        "Admin console rendered by Web Controllers over views/*.scala.html",
        "Both call the same Facade: one behavior, two doors"
      ]
    },
    {
      "dot": "emerald",
      "title": "Layer contract",
      "items": [
        "Controller: parse the colocated *Form, delegate, return okJson",
        "Facade: exec(form), one pool.withTransaction, maps Entity to *Model",
        "Service: optional, reusable or @Cached reads only",
        "Jdbc extends *ORM: SQL and row parse — no Proxy or Processor layer"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "Play filters: CSRF, CSP, allowed hosts, CORS",
        "authorize resolves the Account; org/app scope never comes from the body",
        "config.policy gates rows, fields and values inside the Facade"
      ]
    }
  ]
